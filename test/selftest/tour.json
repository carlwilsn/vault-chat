{
  "pace": 700,
  "steps": [
    { "waitFor": "#root > *", "timeout": 30000, "label": "the window paints" },
    { "expect": { "health": "server", "timeout": 120000 }, "label": "the app's own server answers" },
    { "waitFor": "[data-tree-path$='/Welcome.md']", "timeout": 30000, "label": "the file tree lists the vault" },

    { "click": "[data-el=file-tree] button[title='Add to vault']", "label": "file tree: add" },
    { "click": { "text": "New file" } },
    { "waitFor": "input[placeholder=filename]" },
    { "type": "tour-file", "into": "input[placeholder=filename]" },
    { "press": "Enter" },
    { "expect": { "file": "tour-file.md", "timeout": 10000 }, "label": "file tree: created tour-file.md" },
    { "waitFor": "[data-tree-path$='/tour-file.md']", "timeout": 10000 },
    { "rightClick": "[data-tree-path$='/tour-file.md']", "label": "file tree: right-click" },
    { "click": { "role": "button", "name": "Rename" } },
    { "type": "tour-renamed", "label": "file tree: type the new name" },
    { "press": "Enter" },
    { "expect": { "file": "tour-renamed.md", "timeout": 10000 }, "label": "file tree: renamed to tour-renamed.md" },
    { "expect": { "noFile": "tour-file.md", "timeout": 10000 } },
    { "waitFor": "[data-tree-path$='/tour-renamed.md']", "timeout": 10000 },
    { "rightClick": "[data-tree-path$='/tour-renamed.md']" },
    { "click": { "role": "button", "name": "Delete" }, "label": "file tree: delete" },
    { "click": "button.bg-destructive", "label": "file tree: confirm delete" },
    { "expect": { "noFile": "tour-renamed.md", "timeout": 10000 }, "label": "file tree: deleted" },

    { "click": "[data-tree-path$='/Welcome.md']", "label": "open Welcome.md" },
    { "waitFor": "[data-file$='/Welcome.md'] .cm-content", "timeout": 15000 },
    { "select": "[data-file$='/Welcome.md'] .cm-content", "text": "The quick brown fox", "label": "select words in the editor" },
    { "press": "Mod+K", "label": "Mod+K: edit the selection" },
    { "waitFor": "textarea[data-perf-target=ctrl-k]", "timeout": 10000 },
    { "type": "Make it shorter", "into": "textarea[data-perf-target=ctrl-k]" },
    { "press": "Enter" },
    { "waitFor": "[data-el=ask-answer]", "timeout": 30000, "label": "Mod+K: the answer streams" },
    { "waitFor": "[data-el=ask-answer][data-state=done]", "timeout": 30000, "label": "Mod+K: answered" },
    { "click": "textarea[data-perf-target=ctrl-k]" },
    { "press": "Escape", "label": "Esc closes the box" },
    { "expect": { "gone": "textarea[data-perf-target=ctrl-k]", "timeout": 5000 } },
    { "press": "Mod+E", "label": "Mod+E: to the rendered view" },
    { "waitFor": "[data-file$='/Welcome.md'][data-mode=viewing]", "timeout": 15000 },
    { "select": "[data-file$='/Welcome.md']", "text": "The quick brown fox reads a PDF", "label": "select a sentence" },
    { "press": "Mod+L", "label": "Mod+L: ask about the selection" },
    { "waitFor": "textarea[data-perf-target=ctrl-k]", "timeout": 10000 },
    { "type": "What does this sentence say?", "into": "textarea[data-perf-target=ctrl-k]" },
    { "press": "Enter" },
    { "waitFor": "[data-el=ask-answer]", "timeout": 30000, "label": "Mod+L: the answer streams" },
    { "waitFor": "[data-el=ask-answer][data-state=done]", "timeout": 30000, "label": "Mod+L: answered" },
    { "click": "textarea[data-perf-target=ctrl-k]" },
    { "press": "Escape", "label": "Esc closes the box" },
    { "expect": { "gone": "textarea[data-perf-target=ctrl-k]", "timeout": 5000 } },

    { "drag": "[data-tree-path$='/Second note.md']", "to": "[data-el=markdown-area]", "at": { "x": 0.93, "y": 0.5 }, "label": "split: drag Second note to the right edge" },
    { "waitFor": "[data-file$='/Second note.md']", "timeout": 15000 },
    { "waitFor": "[data-file$='/Welcome.md'][data-active=false]", "timeout": 5000, "label": "split: two files side by side" },
    { "wait": 1000 },

    { "click": "[data-tree-path$='/sample.pdf']", "label": "open the PDF" },
    { "waitFor": "[data-file$='/sample.pdf'] canvas", "timeout": 30000, "label": "the PDF draws" },
    { "click": "[data-file$='/sample.pdf'] [data-look-scroll]" },
    { "press": "Mod+M", "label": "Mod+M: marquee mode" },
    { "drag": "[data-file$='/sample.pdf'] canvas", "to": "[data-file$='/sample.pdf'] canvas", "start": { "x": 0.15, "y": 0.1 }, "at": { "x": 0.75, "y": 0.35 }, "label": "drag a marquee box" },
    { "waitFor": "textarea[data-perf-target=ctrl-k]", "timeout": 10000, "label": "the marquee opens the ask box" },
    { "press": "Escape" },
    { "expect": { "gone": "textarea[data-perf-target=ctrl-k]", "timeout": 5000 } },

    { "press": "Mod+Shift+B", "label": "Mod+Shift+B: show the chat panel" },
    { "waitFor": "[data-el=chat-transcript]", "timeout": 15000 },
    { "waitFor": "textarea[data-perf-target=composer]:not([disabled])", "timeout": 30000, "label": "chat: the composer is ready" },
    { "click": "textarea[data-perf-target=composer]" },
    { "type": "Hello from the self-test tour", "into": "textarea[data-perf-target=composer]", "label": "chat: type a message" },
    { "press": "Enter", "label": "chat: send" },
    { "waitFor": { "text": "Hello from the self-test tour" }, "timeout": 15000 },
    { "expect": { "text": "Hello from the fake model", "timeout": 90000 }, "label": "chat: the reply streams in" },
    { "expect": { "text": "so the tour can watch it arrive", "timeout": 60000 }, "label": "chat: the whole reply" },

    { "click": "button[title='Pop out chat']", "label": "pop out the chat" },
    { "expect": { "window": "chat-popout", "open": true, "timeout": 30000 }, "label": "the popout window is open" },
    { "waitFor": "button[title='Chat is popped out']", "timeout": 10000 },
    { "wait": 2500 },
    { "closeWindow": "chat-popout", "label": "close the popout" },
    { "expect": { "window": "chat-popout", "open": false, "timeout": 15000 }, "label": "the popout window is closed" },
    { "waitFor": "button[title='Pop out chat']", "timeout": 10000, "label": "the chat is docked again" },

    { "click": "button[title=Settings]", "label": "open Settings" },
    { "waitFor": "[data-el=settings-pane]", "timeout": 10000 },
    { "expect": { "text": "Appearance" } },
    { "scroll": 600, "in": "[data-el=settings-scroll]" },
    { "wait": 1000 },
    { "click": "button[title=Settings]", "label": "close Settings" },
    { "expect": { "gone": "[data-el=settings-pane]", "timeout": 10000 }, "label": "Settings closed" }
  ]
}
