# Managed by vault-chat. Ephemeral machine-local state — never synced.
.vault-chat/run-heartbeat.json
.vault-chat/firer-heartbeat.json
.vault-chat/*heartbeat*.conflict
.vault-chat/app-log.txt
.vault-chat/app-log.1.txt
.vault-chat/client-events.jsonl
.vault-chat/client-events.1.jsonl
.vault-chat/diag/
.vault-chat/sync-log.jsonl
.vault-chat/pending-wakes.json
.vault-chat/*.bak
.vault-chat/*.tmp
__pycache__/
*.pyc

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code scratch / config — local, EXCEPT versioned skills (dev tooling)
.claude/*
!.claude/skills/

# Agent scratch files — created by in-app agent tool calls
_check.*
_scratch.*

# Bundled sidecar binaries (Tectonic LaTeX engine). Downloaded at build
# time by scripts/download-tectonic.mjs and bundled as a Tauri resource.
src-tauri/binaries/

.env.local
.env*.local

# Headless server bundle (npm run build:server)
dist-server/

# preview screenshots (before/after proof)
preview-proof/

# This project folder's own local notes (personal memory; never committed)
/.vault-chat/
