# ~/.config/vault-chat-server.env — read by vault-chat-server.service.
# No secrets here: keys are read in-process from ~/.config/vault-chat/secrets.age.
VC_HOST=127.0.0.1
VC_PORT=8848
# The vault-chat folder (server/master.ts): vaults/ and projects/ in it, each synced with the laptop.
VC_MASTER=%HOME%/vc
VC_VAULT=%HOME%/vc/vaults/school2
VC_LOCALSTORAGE=%HOME%/.local/share/com.vault-chat.app/mission-engine.localstorage
VC_ALLOWED_LOGINS=carwilson0929@gmail.com
