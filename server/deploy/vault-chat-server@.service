# vault-chat-server@<port> — the box's headless vault-chat (phone routes, agent turns, voice, vault sync)
# on a private port behind vault-chat-front (8848). Two slots, 8851 and 8852: an update starts the
# next version in the other slot, which reads ahead and stands by until this one has no running
# work and hands over (vault-chat-update.sh, server/owner.ts). The bundle is `current` at start.
[Unit]
Description=vault-chat server on private port %i (behind vault-chat-front)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# node is resolved through PATH: on thinkbox it is /etc/profiles/per-user/%u/bin/node.
# VC_BACKEND_PORT through env: the env file's VC_PORT (the public port) would override Environment=.
ExecStart=/usr/bin/env VC_BACKEND_PORT=%i node %h/.local/state/vault-chat-server/current/vault-chat-server.mjs
EnvironmentFile=%h/.config/vault-chat-server.env
# The agent sandbox hides this file (it can hold tokens); systemd does not tell the process its path.
Environment=VC_ENV_FILE=%h/.config/vault-chat-server.env
Environment=PATH=/run/wrappers/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin
Environment=NODE_ENV=production
WorkingDirectory=%h
# A crash comes back in the same slot (the front holds requests meanwhile); a hand-over's clean exit does not.
Restart=on-failure
RestartSec=2
# Let a mission's child processes die with the server, not linger.
KillMode=control-group
TimeoutStopSec=30
# The box's memory limits (set on vault-chat-server.service by hand before).
MemoryHigh=6G
MemoryMax=7G
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=60%
