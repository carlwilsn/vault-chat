{
  "name": "vault-chat",
  "private": true,
  "version": "0.6.70",
  "description": "Minimal desktop viewer + LLM chat for a folder of markdown notes. Ctrl+K inline edit, PDF marquee ask with vision, an agent that can modify its own config.",
  "author": "Carl Wilson",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vault-chat": "./bin/vault-chat.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "node preview/serve.mjs",
    "dev:phone": "vite --config phone/vite.config.ts",
    "build:phone": "vite build --config phone/vite.config.ts",
    "typecheck:phone": "tsc --noEmit -p phone",
    "dev:board": "vite --config board/vite.config.ts",
    "build:board": "vite build --config board/vite.config.ts",
    "typecheck:board": "tsc --noEmit -p board",
    "tauri": "tauri",
    "predev:tauri": "node scripts/download-tectonic.mjs",
    "build:server": "npm run build:phone && npm run build:board && node server/build.mjs --phone-app --board-app",
    "test:server": "node server/build.mjs && vitest run --config server/vitest.config.ts",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "test:harness": "node --import tsx --import ./test/harness/register.mjs --test \"test/harness/*.test.ts\"",
    "context:audit": "node server/build.mjs && vitest run --config server/vitest.config.ts server/test/contextAudit.test.ts",
    "preview:test": "node preview/test.mjs",
    "preview:record": "node preview/record.mjs",
    "vite:preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@elevenlabs/client": "^1.28.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "allotment": "^1.20.5",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^5.6.205",
    "perfect-freehand": "^1.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "speech-rule-engine": "4.1.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.6.0",
    "age-encryption": "^0.3.1",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.27.7",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
