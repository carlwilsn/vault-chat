{
  // The whiteboard app (vanilla TS: the ink path has no framework in it).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "types": []
  },
  "include": ["src", "../src/boardFormat.ts", "../src/inboxFormat.ts", "../src/widgetHost.ts"]
}
